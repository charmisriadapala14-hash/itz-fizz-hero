<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ITZ FIZZ - Scroll Hero</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="style.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
</head>
<body class="bg-[#fdf8ee]">
  <div class="scroll-wrapper">
    <section id="hero">
      <div class="top-content">
        <h1 id="headline"></h1>
        <p id="progress">Scroll — 0%</p>
      </div>

      <div class="track-area">
        <div class="track-bg"><div id="trail"></div></div>
        <div id="car">
          <div class="wheel left"></div>
          <div class="wheel right"></div>
        </div>
      </div>

      <div class="stats">
        <div class="card"><h2>58%</h2><p>User Activity</p></div>
        <div class="card"><h2>23%</h2><p>Click Rate</p></div>
        <div class="card dark"><h2>27%</h2><p>Conversion</p></div>
        <div class="card green"><h2>100%</h2><p>Scroll Linked</p></div>
      </div>
    </section>
  </div>
  <script src="script.js"></script>
</body>
</html>
