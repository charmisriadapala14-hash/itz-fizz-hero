<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ITZ FIZZ - Scroll Hero</title>
  <meta name="description" content="A creative scroll-driven hero website built with HTML, CSS and JavaScript.">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ITZ FIZZ - Scroll Hero",
    "url": "https://charmisriadapala14-hash.github.io/itz-fizz-hero/",
    "description": "A creative scroll-driven hero website built with HTML, CSS and JavaScript."
  }
  </script>

  <link rel="stylesheet" href="style.css">
</head>
<body>

  <section class="hero" id="hero">
    <div class="content">
      <p class="small-text">DISCOVER THE EXPERIENCE</p>
      <h1>ITZ FIZZ</h1>

      <div class="stats">
        <div class="stat">
          <h2>01</h2>
          <p>Creative Design</p>
        </div>
        <div class="stat">
          <h2>02</h2>
          <p>Smooth Animation</p>
        </div>
        <div class="stat">
          <h2>03</h2>
          <p>Modern Experience</p>
        </div>
        <div class="stat">
          <h2>04</h2>
          <p>Responsive Layout</p>
        </div>
      </div>
    </div>

    <div class="car">🏎️</div>
    <p class="scroll-text">SCROLL TO EXPLORE ↓</p>
  </section>

  <section class="second-section">
    <h2>Feel the Speed.</h2>
    <p>Explore a creative web experience with animated elements and a modern design.</p>
  </section>

  <script src="script.js"></script>
</body>
</html>
